{
  "name": "pi-smart-compact",
  "version": "3.10.1",
  "description": "Branch-scoped pinned memory extension for Pi with token-efficient context packing and deterministic journal replay.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oleg3190/pi-smart-compact.git"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "typebox": "1.3.27"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types tests/runtime.ts && node tests/verify.mjs",
    "bench": "node --experimental-strip-types bench/run.mjs",
    "bench:dialog": "node bench/analyze-dialog.mjs",
    "bench:dialog:test": "node bench/analyze-dialog.mjs --self-test"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
